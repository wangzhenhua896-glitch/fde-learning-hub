    {
      "id": "discover-brief",
      "title": "把模糊需求写成验收问题",
      "format": "micro_lesson",
      "skills": [
        "discovery"
      ],
      "prerequisites": [],
      "difficulty": 1,
      "estimated_time": 8,
      "evidence_of_mastery": "回答场景判断题",
