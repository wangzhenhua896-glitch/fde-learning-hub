  "labTemplates": {
    "access-v1": {
      "level": 1,
      "prompt": "虚构客户的财务资料只允许财务组查看。选择最安全的检索方案。",
      "choices": [
        "按用户身份在检索前过滤",
        "检索所有资料后隐藏答案",
        "请模型自行判断权限"
      ],
      "answer": 0,
      "hints": [
        "想想数据什么时候离开检索层。",
        "重点检查候选文档形成之前的权限判断。",
        "先判断身份，再只检索允许访问的文档。",
        "完整解释：权限过滤必须在检索前完成，生成后隐藏不能撤回泄露。"
      ]
    },
    "citation-v1": {
      "level": 1,
      "prompt": "虚构知识库没有找到客户退款政策。你会如何回答？",
      "choices": [
        "编一个合理政策",
        "说明没有找到依据并请求确认资料",
        "引用一份无关文档"
      ],
      "answer": 1,
      "hints": [
        "先判断有没有足够证据。",
        "定位在回答生成之前的证据检查。",
        "证据不足就拒答并请求可信资料。",
        "完整解释：没有找到政策时不应猜测，也不能伪造引用。"
      ]
    },
