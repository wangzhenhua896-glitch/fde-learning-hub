        "integrate-map"
      ],
      "review_policy": {
        "after_days": [
          1,
          3,
          7
        ]
      },
      "body": "客户说‘做个知识助手’时，先问谁使用、要解决什么、什么答案可接受、哪些资料不可见。把成功标准写成可观察的行为，再谈技术方案。",
      "question": {
        "prompt": "客户提出‘让 AI 回答员工问题’，你首先应该做什么？",
        "options": [
          "直接挑模型",
          "确认用户、边界与验收标准",
          "先部署数据库"
        ],
        "answer": 1
      },
      "diagnostic_question": {
        "prompt": "客户说“做个知识助手”，你会先确认哪项？",
